# RepoPilot AI — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# For local dev (uv / uvicorn directly):
#   - Place this file as  backend/.env
#   - DATABASE_URL should point to localhost:5432
#
# For Docker (docker compose up):
#   - Place this file as  .env  next to docker-compose.yml
#   - DATABASE_URL is overridden by docker-compose.yml automatically
#   - Put repos to analyze inside the  ./repos/  folder
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider (required) ──────────────────────────────────────────────────
# LiteLLM model string — swap provider without changing code.
# Examples:
#   gemini/gemini-2.0-flash
#   anthropic/claude-haiku-4-5-20251001
#   openai/gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash

# Provider API key — set the one matching your LLM_MODEL:
GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Database (local dev only — Docker overrides this) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repopilot

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=repopilot_code

# ── Agent limits ──────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=25
AGENT_MAX_TOOL_CALLS=60

# ── Security ──────────────────────────────────────────────────────────────────
# Leave empty in development to allow any absolute path.
# In Docker this is set to /repos automatically by docker-compose.yml.
# ALLOWED_REPO_ROOT=/srv/repos
