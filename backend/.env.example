# RepoPilot AI — environment configuration
# Copy this file to .env and fill in actual values.
# Never commit .env to version control.

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@localhost:5432/repopilot

# Embedding provider: "sentence_transformers" (default) or "openai"
# Use "openai" where PyTorch DLLs are unavailable (e.g. Windows App Control environments).
# EMBEDDING_PROVIDER=sentence_transformers

# Embedding model name — interpreted by EMBEDDING_PROVIDER.
# For sentence_transformers: a model name from the HuggingFace Hub.
# For openai: an OpenAI embedding model (e.g. text-embedding-3-small).
# Do NOT mix providers in the same ChromaDB collection (different vector dimensions).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB local persistence directory
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ChromaDB collection name
CHROMA_COLLECTION_NAME=repopilot_code

# Chunking config (optional — sensible defaults are set)
# CHUNK_MAX_LINES=80
# CHUNK_OVERLAP_LINES=5

# Agent tool limits (optional — sensible defaults are set)
# TOOL_SEARCH_MAX_RESULTS=20
# TOOL_FILE_MAX_LINES=200
# TOOL_GRAPH_MAX_RESULTS=50

# LLM / Agent configuration
# LiteLLM model string — provider/model, e.g.:
#   gemini/gemini-2.0-flash          ← recommended: fast, tool-calling capable
#   gemini/gemini-2.5-flash
#   gemini/gemini-2.5-pro
#   anthropic/claude-haiku-4-5-20251001
#   anthropic/claude-sonnet-4-5
#   openai/gpt-4o
#   openai/gpt-4o-mini
# LLM_MODEL=gemini/gemini-2.0-flash

# Provider API keys — picked up by LiteLLM from environment
# GEMINI_API_KEY=AIza...              ← Google AI Studio key for Gemini models
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# LLM generation settings (optional — sensible defaults are set)
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.0

# Agent loop limits (optional — sensible defaults are set)
# AGENT_MAX_ITERATIONS=10
# AGENT_MAX_TOOL_CALLS=30

# API / CORS
# Comma-separated list of allowed origins for the browser CORS check.
# NEVER use * in production — list your actual frontend origin(s).
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.example.com

# Security boundary for repository paths.
# When set, all repository local_path values must reside under this directory.
# Leave empty (default) to allow any valid absolute path (development mode only).
# ALLOWED_REPO_ROOT=/srv/repos
